# Copy to a private .env.production on the server and replace every placeholder.
# Never commit the populated file or put these server secrets in VITE_* variables.
FRONTEND_IMAGE=sady567/slm-frontend:<reviewed-main-tag>
FRONTEND_PORT=5175
FRONTEND_ORIGIN=https://<approved-hostname>
AUTH_PUBLIC_URL=https://<approved-hostname>/auth

# Generate new, unique secrets for this deployment. Do not reuse Data.txt values.
AUTH_DB_NAME=tunelab_auth
AUTH_DB_USER=tunelab
AUTH_DB_PASSWORD=<new-random-secret>
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=<new-random-secret>

# Existing Engine network and service routing on the server.
ENGINE_DOCKER_NETWORK=slm-platform_slm-net
ENGINE_UPSTREAM=slm-edge:80
ENGINE_UPSTREAM_HOST=edge
