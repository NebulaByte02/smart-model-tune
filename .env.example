# Public OIDC settings only. No database password or admin secret in VITE_*.
VITE_AUTH_URL="/auth"
VITE_AUTH_REALM="tunelab"
VITE_AUTH_CLIENT_ID="tunelab-web"
VITE_ENGINE_HOST=""
VITE_ENGINE_PROXY_TARGET="http://localhost:8088"
# Vite forwards /auth to the Compose frontend. Start Compose before npm run dev.
AUTH_PROXY_TARGET="http://localhost:5175"

FRONTEND_PORT=5175
FRONTEND_ORIGIN=http://localhost:5175
DEV_ORIGIN=http://localhost:5173
AUTH_PUBLIC_URL=http://localhost:5175/auth
AUTH_DB_NAME=tunelab_auth
AUTH_DB_USER=tunelab
AUTH_DB_PASSWORD=
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=
ENGINE_UPSTREAM=host.docker.internal:8088
ENGINE_UPSTREAM_HOST=localhost
