VITE_SUPABASE_PROJECT_ID="replace-with-your-project-ref"
VITE_SUPABASE_PUBLISHABLE_KEY="replace-with-supabase-publishable-key"
VITE_SUPABASE_URL="https://replace-with-your-project-ref.supabase.co"

# Empty means the browser calls /api/v1, /ws and /health on its own origin.
# Set a full origin only when the frontend and Engine are hosted separately.
VITE_ENGINE_HOST=""

# Used only by `npm run dev`; Vite proxies relative Engine routes here.
VITE_ENGINE_PROXY_TARGET="http://localhost:8088"
