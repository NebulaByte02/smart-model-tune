{
  "realm": "tunelab",
  "enabled": true,
  "displayName": "TuneLab",
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": true,
  "bruteForceProtected": true,
  "clients": [
    {
      "clientId": "tunelab-web",
      "name": "TuneLab Web",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "${TUNELAB_WEB_ORIGIN}/*",
        "${TUNELAB_DEV_ORIGIN}/*"
      ],
      "webOrigins": [
        "${TUNELAB_WEB_ORIGIN}",
        "${TUNELAB_DEV_ORIGIN}"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${TUNELAB_WEB_ORIGIN}/*##${TUNELAB_DEV_ORIGIN}/*"
      },
      "defaultClientScopes": [
        "basic",
        "web-origins",
        "acr",
        "profile",
        "roles",
        "email"
      ],
      "protocolMappers": [
        {
          "name": "tunelab-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "tunelab-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "passwordPolicy": "length(12)",
  "accessTokenLifespan": 300,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "groups": [
    {
      "name": "self-service-account",
      "clientRoles": {
        "account": [
          "delete-account"
        ]
      }
    }
  ],
  "defaultGroups": [
    "/self-service-account"
  ],
  "requiredActions": [
    {
      "alias": "CONFIGURE_TOTP",
      "name": "Configure OTP",
      "providerId": "CONFIGURE_TOTP",
      "enabled": true,
      "defaultAction": false,
      "priority": 10,
      "config": {}
    },
    {
      "alias": "UPDATE_PASSWORD",
      "name": "Update Password",
      "providerId": "UPDATE_PASSWORD",
      "enabled": true,
      "defaultAction": false,
      "priority": 30,
      "config": {}
    },
    {
      "alias": "UPDATE_PROFILE",
      "name": "Update Profile",
      "providerId": "UPDATE_PROFILE",
      "enabled": true,
      "defaultAction": false,
      "priority": 40,
      "config": {}
    },
    {
      "alias": "VERIFY_EMAIL",
      "name": "Verify Email",
      "providerId": "VERIFY_EMAIL",
      "enabled": true,
      "defaultAction": false,
      "priority": 50,
      "config": {}
    },
    {
      "alias": "delete_account",
      "name": "Delete Account",
      "providerId": "delete_account",
      "enabled": true,
      "defaultAction": false,
      "priority": 60,
      "config": {}
    }
  ]
}
